{
  "defaultAgent": "custom",
  "defaultHarness": "custom-fast",
  "agents": {
    "claude": {
      "name": "Claude",
      "acp": {
        "cmd": "/fixtures/bin/node",
        "args": [
          "/fixtures/tandem/runtime/node_modules/@agentclientprotocol/claude-agent-acp/dist/index.js"
        ]
      },
      "terminal": {
        "cmd": "claude",
        "args": [
          "--resume",
          "{sessionId}"
        ]
      }
    },
    "codex": {
      "name": "Codex",
      "acp": {
        "cmd": "/fixtures/bin/node",
        "args": [
          "/fixtures/tandem/runtime/node_modules/@agentclientprotocol/codex-acp/dist/index.js"
        ]
      },
      "terminal": {
        "cmd": "codex",
        "args": [
          "resume",
          "{sessionId}"
        ]
      }
    },
    "custom": {
      "name": "Custom Agent",
      "acp": {
        "cmd": "/fixtures/bin/node",
        "args": [
          "/fixtures/tandem/runtime/mock-acp-agent.mjs"
        ],
        "env": {
          "FIXTURE_HOME": "{home}"
        }
      }
    },
    "pi": {
      "name": "Pi",
      "acp": {
        "cmd": "/fixtures/bin/node",
        "args": [
          "/fixtures/tandem/runtime/node_modules/pi-acp/dist/index.js"
        ]
      },
      "terminal": {
        "cmd": "pi",
        "args": [
          "--session",
          "{sessionId}"
        ]
      }
    }
  },
  "harnesses": {
    "custom-fast": {
      "agent": "custom",
      "name": "Custom Fast",
      "acpArgs": [
        "--fast"
      ],
      "terminalArgs": []
    }
  }
}
