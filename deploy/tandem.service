[Unit]
Description=Tandem native daemon (multi-agent orchestration)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/tandem
Environment=PATH=%h/.local/share/fnm/aliases/default/bin:/usr/local/go/bin:/usr/bin:/bin
# Shared browser: drive per-agent CDP sessions through a self-hosted Steel
# (docker: ghcr.io/steel-dev/steel-browser on :3000). To avoid this external
# dependency, remove these two lines and use the installed-Chrome local driver.
Environment=TANDEM_BROWSER_DRIVER=steel
Environment=STEEL_BASE_URL=http://localhost:3000
# Keep this major version aligned with the Chromium bundled by the Steel image.
# This removes the explicit HeadlessChrome token; CHROME_HEADLESS=false on the
# Steel container is preferable when the host can run its display-capable mode.
Environment="STEEL_SESSION_OPTIONS={\"userAgent\":\"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/149.0.0.0 Safari/537.36\",\"dimensions\":{\"width\":1365,\"height\":768},\"persistProfile\":true}"
# Builds the Go executable with the React UI embedded, then execs `tandem daemon`.
ExecStart=%h/Projects/tandem/start-dev-server.sh
# Deferred redeploys intentionally exit cleanly after all active turns finish.
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
