[Unit]
Description=Tandem native daemon (multi-agent orchestration)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/tandem
Environment=PATH=%h/.local/share/fnm/aliases/default/bin:/usr/local/go/bin:/usr/local/sbin:/usr/local/bin:/usr/bin:/bin
# Shared browser: the local driver launches installed Google Chrome per agent
# (headful under a private Xvfb, with anti-detection flags) and serves CDP.
Environment=TANDEM_BROWSER_DRIVER=local
Environment=TANDEM_CHROMIUM_EXECUTABLE=google-chrome-stable
# Optional: drive sessions through a self-hosted Steel instead (docker:
# ghcr.io/steel-dev/steel-browser on :3000). Replace the two lines above with:
#Environment=TANDEM_BROWSER_DRIVER=steel
#Environment=STEEL_BASE_URL=http://localhost:3000
# Keep this major version aligned with the Chromium bundled by the Steel image.
#Environment="STEEL_SESSION_OPTIONS={\"userAgent\":\"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/149.0.0.0 Safari/537.36\",\"dimensions\":{\"width\":1365,\"height\":768},\"persistProfile\":true}"
# Builds the Go executable with the React UI embedded, then execs `tandem`.
ExecStart=%h/Projects/tandem/start-dev-server.sh
# Deferred redeploys intentionally exit cleanly after all active turns finish.
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
