version: 1

defaults:
  agent: claude

agents:
  claude:
    name: Claude
    history:
      parser: "{runtimeRoot}/history/importers/claude.ts"
      resume: auto
    acp:
      command: "{node}"
      args:
        - "{runtimeRoot}/node_modules/@agentclientprotocol/claude-agent-acp/dist/index.js"
      # The Claude ACP bridge stamps the spawning Task/Agent tool call's id onto
      # subagent-originated session/updates under this `_meta` path. Tandem reads
      # it into a normalized `parentId` so subagent activity groups under its
      # spawn instead of interleaving with the parent's transcript. Other agents
      # omit `meta` and render flat; point this at their path if they adopt one.
      meta:
        parentToolCallIdPath: claudeCode.parentToolUseId
    terminal:
      command: claude
      startArgs: []
      resumeArgs: [--resume, "{sessionId}"]

  codex:
    name: Codex
    history:
      parser: "{runtimeRoot}/history/importers/codex.ts"
      resume: auto
    acp:
      command: "{node}"
      args:
        - "{runtimeRoot}/node_modules/@agentclientprotocol/codex-acp/dist/index.js"
    terminal:
      command: codex
      startArgs: []
      resumeArgs: [resume, "{sessionId}"]

  pi:
    name: Pi
    history:
      parser: "{runtimeRoot}/history/importers/pi.ts"
      resume: auto
    acp:
      command: "{node}"
      args:
        - "{runtimeRoot}/node_modules/pi-acp/dist/index.js"
    terminal:
      command: pi
      startArgs: []
      resumeArgs: [--session, "{sessionId}"]

  opencode:
    name: OpenCode
    history:
      parser: "{runtimeRoot}/history/importers/opencode.ts"
      resume: terminal
    terminal:
      command: opencode
      startArgs: []
      resumeArgs: [--session, "{sessionId}"]

# Agent definitions may attach a vendor-neutral transcript importer. Tandem
# runs the TypeScript module with its configured Node runtime and owns all
# validation, checkpoints, SQLite writes, and FTS indexing. Importer env values
# are treated as secrets in config diagnostics.
#
#  custom:
#    name: Custom
#    terminal:
#      command: custom
#      resumeArgs: [--resume, "{sessionId}"]
#    history:
#      parser: "{home}/importers/custom-history.ts" # must resolve absolute
#      args: [--include-tools]
#      env: {CUSTOM_HISTORY_ROOT: "{home}/.custom/history"}
#      resume: terminal  # auto | acp | terminal
#      enabled: true

harnesses: {}

# Harness-neutral MCP servers are declared once by Tandem and supplied to every
# ACP agent it spawns. Project-local servers live in .tandem/.config.yml with
# the same mcpServers shape; a project entry with the same name overrides this
# global entry. `tandem mcp add NAME COMMAND [ARGS...]` writes this block, and
# `tandem mcp add --project ...` writes the project-local file. New agent
# sessions see additions immediately; existing sessions keep their original
# MCP declarations.
#
# mcpServers:
#   filesystem:
#     command: npx
#     args: [-y, "@modelcontextprotocol/server-filesystem", "/path/to/root"]
#     env:
#       EXAMPLE_TOKEN: ""
#   mem0:
#     type: http
#     url: http://localhost:8081/mcp
#     headers:
#       Authorization: "Bearer example"

# Tandem installs each managed agent's ACP server from npm. When one of them is
# missing something Tandem needs and upstream has not taken the change, an
# `acpForks:` entry makes Tandem install a pinned fork commit instead, and keeps
# watching the published package so the fork can be rebased or retired. This is
# written by `tandem acp fork AGENT ...` rather than by hand; `tandem acp status`
# reports it and `tandem acp upstream AGENT` retires a fork once its change has
# landed upstream. Installs are pinned to `commit`, so pushing the fork branch
# changes nothing until the record is re-pinned.
#
# acpForks:
#   pi:
#     repo: https://github.com/you/pi-acp      # fork remote (http/https)
#     ref: tandem                              # branch carrying the fork's commits
#     commit: 52f61f3850a883b9b5a3bb3245908bd5  # exact tree installed
#     upstreamPackage: pi-acp                   # npm package watched for releases
#     upstreamVersion: 0.0.33                   # release the fork is rebased onto
#     upstreamRepo: https://github.com/svkozak/pi-acp  # for upstreaming checks
#     reason: Emits ACP usage_update so Tandem can show pi context usage
#     upstreamPrs: [114]      # PRs that would make the fork unnecessary
#     clone: ""               # optional; defaults to <runtimeRoot>/forks/<agent>

# The `tandem setup` wizard writes an
# operator-owned `settings:` block to $TANDEM_HOME/config.yml, separate from
# the agent catalog above. It is never present in this shipped example file;
# it's documented here only so the schema is discoverable. All fields are
# optional — env vars (TANDEM_PROJECT_ROOTS, TANDEM_BIND, TANDEM_PORT,
# TANDEM_BROWSER_DRIVER, STEEL_BASE_URL, STEEL_API_KEY, TANDEM_NODE_CMD,
# TANDEM_ACP_FORK_REBASE_PROFILE, and TANDEM_LANGUAGE_MODEL_*, and TANDEM_VOICE_*)
# override it, and built-in defaults fill any gaps.
#
# settings:
#   configVersion: 2        # written by tandem setup; tracks config compatibility
#   projectRoots:          # dirs scanned for repos in the spawn palette
#     - /home/you/Projects
#   bind: 127.0.0.1        # HTTP + WS listen address
#   port: 7717              # HTTP + WS listen port
#   browserDriver: local    # "local" (installed Chrome/Chromium) or "steel"
#   acpForkRebaseProfile: ""  # agent profile spawned to rebase a tracked ACP
#                             # fork (see acpForks above); empty leaves the
#                             # rebase offer informational rather than one-click
#   steelBaseUrl: http://localhost:3000  # required when browserDriver is "steel"
#   steelApiKey: ""         # optional; config.yml is written owner-only
#   node:
#     mode: system           # "system" (use command/PATH) or "managed" (Tandem-downloaded)
#     command: node          # only used when mode is "system"
#     version: 22.11.0       # pinned version downloaded when mode is "managed"
#   languageModel:             # shared Chat Completions model (voice, summaries, titles)
#     endpoint: https://api.openai.com/v1/chat/completions
#     apiKey: ""               # optional for local services; stored owner-only
#     model: gpt-5.6-luna
#   voice:
#     enabled: true
#     instructions: "Rewrite the assistant response as clear, natural speech..."
#     ttsEndpoint: https://api.openai.com/v1/audio/speech
#     ttsApiKey: ""           # optional for local services; stored owner-only
#     ttsModel: tts-1
#     ttsVoice: alloy
#     ttsFormat: mp3
