version: 1

defaults:
  agent: claude

agents:
  claude:
    name: Claude
    history:
      parser: "{runtimeRoot}/history/importers/claude.ts"
      resume: auto
    acp:
      command: "{node}"
      args:
        - "{runtimeRoot}/node_modules/@agentclientprotocol/claude-agent-acp/dist/index.js"
      # The Claude ACP bridge stamps the spawning Task/Agent tool call's id onto
      # subagent-originated session/updates under this `_meta` path. Tandem reads
      # it into a normalized `parentId` so subagent activity groups under its
      # spawn instead of interleaving with the parent's transcript. Other agents
      # omit `meta` and render flat; point this at their path if they adopt one.
      meta:
        parentToolCallIdPath: claudeCode.parentToolUseId
    terminal:
      command: claude
      startArgs: []
      resumeArgs: [--resume, "{sessionId}"]

  codex:
    name: Codex
    history:
      parser: "{runtimeRoot}/history/importers/codex.ts"
      resume: auto
    acp:
      command: "{node}"
      args:
        - "{runtimeRoot}/node_modules/@agentclientprotocol/codex-acp/dist/index.js"
    terminal:
      command: codex
      startArgs: []
      resumeArgs: [resume, "{sessionId}"]

  pi:
    name: Pi
    history:
      parser: "{runtimeRoot}/history/importers/pi.ts"
      resume: auto
    acp:
      command: "{node}"
      args:
        - "{runtimeRoot}/node_modules/pi-acp/dist/index.js"
    terminal:
      command: pi
      startArgs: []
      resumeArgs: [--session, "{sessionId}"]

  opencode:
    name: OpenCode
    history:
      parser: "{runtimeRoot}/history/importers/opencode.ts"
      resume: terminal
    terminal:
      command: opencode
      startArgs: []
      resumeArgs: [--session, "{sessionId}"]

# Agent definitions may attach a vendor-neutral transcript importer. Tandem
# runs the TypeScript module with its configured Node runtime and owns all
# validation, checkpoints, SQLite writes, and FTS indexing. Importer env values
# are treated as secrets in config diagnostics.
#
#  custom:
#    name: Custom
#    terminal:
#      command: custom
#      resumeArgs: [--resume, "{sessionId}"]
#    history:
#      parser: "{home}/importers/custom-history.ts" # must resolve absolute
#      args: [--include-tools]
#      env: {CUSTOM_HISTORY_ROOT: "{home}/.custom/history"}
#      resume: terminal  # auto | acp | terminal
#      enabled: true

harnesses: {}

# The `tandem setup` wizard writes an
# operator-owned `settings:` block to $TANDEM_HOME/config.yml, separate from
# the agent catalog above. It is never present in this shipped example file;
# it's documented here only so the schema is discoverable. All fields are
# optional — env vars (TANDEM_PROJECT_ROOTS, TANDEM_BIND, TANDEM_PORT,
# TANDEM_BROWSER_DRIVER, STEEL_BASE_URL, STEEL_API_KEY, TANDEM_NODE_CMD)
# override it, and built-in defaults fill any gaps.
#
# settings:
#   projectRoots:          # dirs scanned for repos in the spawn palette
#     - /home/you/Projects
#   bind: 127.0.0.1        # HTTP + WS listen address
#   port: 7717              # HTTP + WS listen port
#   browserDriver: local    # "local" (installed Chrome/Chromium) or "steel"
#   steelBaseUrl: http://localhost:3000  # required when browserDriver is "steel"
#   steelApiKey: ""         # optional; config.yml is written owner-only
#   node:
#     mode: system           # "system" (use command/PATH) or "managed" (Tandem-downloaded)
#     command: node          # only used when mode is "system"
#     version: 22.11.0       # pinned version downloaded when mode is "managed"
