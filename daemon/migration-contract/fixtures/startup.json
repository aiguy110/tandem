{
  "readyLine": {
    "stream": "stdout",
    "pattern": "^TANDEM_READY port=(\\d+) token=(\\S+)$"
  },
  "normalShutdown": {
    "signals": [
      "SIGINT",
      "SIGTERM"
    ],
    "exitCode": 0
  },
  "startupFailure": {
    "stream": "stderr",
    "exitCode": 1
  },
  "precedingOutput": [
    "tandem daemon · http+ws on <bind>:<port> · home <home>",
    "browser: driver=<driver> mcp=<on|off>",
    "restored <count> agent(s)",
    "bootstrap: <url>"
  ]
}
